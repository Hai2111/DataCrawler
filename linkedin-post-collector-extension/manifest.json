{
  "manifest_version": 3,
  "name": "LinkedIn URL Demand Collector",
  "version": "0.1.1",
  "description": "URL-driven LinkedIn post collection with validation, partial-record recovery, demand detection and JSON export.",
  "permissions": ["activeTab", "downloads", "storage", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://www.linkedin.com/*", "http://127.0.0.1:32145/*"],
  "action": {
    "default_title": "LinkedIn Demand Collector",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["extractor-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
